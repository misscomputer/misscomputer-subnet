{
  "$defs": {
    "ActiveAssignmentManifest": {
      "additionalProperties": false,
      "properties": {
        "assignment_vector_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assignment Vector Digest Sha256",
          "type": "string"
        },
        "central_authority_fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Central Authority Fingerprint Sha256",
          "type": "string"
        },
        "deployments": {
          "items": {
            "$ref": "#/$defs/ActiveDeploymentAssignment"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Deployments",
          "type": "array"
        },
        "expires_at_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Expires At Epoch",
          "type": "integer"
        },
        "finalized_block_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Finalized Block Hash",
          "type": "string"
        },
        "finalized_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Finalized Epoch",
          "type": "integer"
        },
        "finalized_height": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Finalized Height",
          "type": "integer"
        },
        "issued_at_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Issued At Epoch",
          "type": "integer"
        },
        "manifest_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Digest Sha256",
          "type": "string"
        },
        "netuid": {
          "const": 24,
          "title": "Netuid",
          "type": "integer"
        },
        "network": {
          "const": "finney",
          "title": "Network",
          "type": "string"
        },
        "previous_manifest_digest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Manifest Digest Sha256"
        },
        "probe_port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Probe Port",
          "type": "integer"
        },
        "probe_scheme": {
          "const": "https",
          "title": "Probe Scheme",
          "type": "string"
        },
        "purpose": {
          "const": "active_assignment_manifest_publication_v1",
          "title": "Purpose",
          "type": "string"
        },
        "route_host_suffix": {
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
          "title": "Route Host Suffix",
          "type": "string"
        },
        "schema": {
          "const": "miss.computer/misscomputer-subnet/active-assignment-manifest",
          "title": "Schema",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sequence": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "trust_policy_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trust Policy Digest Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schema_version",
        "purpose",
        "network",
        "netuid",
        "central_authority_fingerprint_sha256",
        "trust_policy_digest_sha256",
        "finalized_height",
        "finalized_block_hash",
        "finalized_epoch",
        "sequence",
        "previous_manifest_digest_sha256",
        "issued_at_epoch",
        "expires_at_epoch",
        "route_host_suffix",
        "probe_scheme",
        "probe_port",
        "deployments",
        "assignment_vector_digest_sha256",
        "manifest_digest_sha256"
      ],
      "title": "ActiveAssignmentManifest",
      "type": "object"
    },
    "ActiveDeploymentAssignment": {
      "additionalProperties": false,
      "description": "One public route with its centrally expected challenge response and replicas.",
      "properties": {
        "assignment_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assignment Digest Sha256",
          "type": "string"
        },
        "attestation_requirement": {
          "const": "miner_service_key_v1",
          "title": "Attestation Requirement",
          "type": "string"
        },
        "build_id": {
          "pattern": "^[0-9a-f]{24}$",
          "title": "Build Id",
          "type": "string"
        },
        "campaign_sequence": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Campaign Sequence",
          "type": "integer"
        },
        "challenge_path": {
          "pattern": "^/__challenge/[0-9a-f]{24}$",
          "title": "Challenge Path",
          "type": "string"
        },
        "challenge_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Challenge Sha256",
          "type": "string"
        },
        "deployment_id": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Deployment Id",
          "type": "string"
        },
        "expected_status": {
          "const": 200,
          "title": "Expected Status",
          "type": "integer"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "replicas": {
          "items": {
            "$ref": "#/$defs/AssignedReplica"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Replicas",
          "type": "array"
        },
        "route_host": {
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
          "title": "Route Host",
          "type": "string"
        },
        "workload_spec_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workload Spec Digest Sha256",
          "type": "string"
        }
      },
      "required": [
        "deployment_id",
        "campaign_sequence",
        "route_host",
        "challenge_path",
        "build_id",
        "challenge_sha256",
        "expected_status",
        "image_digest",
        "workload_spec_digest_sha256",
        "attestation_requirement",
        "replicas",
        "assignment_digest_sha256"
      ],
      "title": "ActiveDeploymentAssignment",
      "type": "object"
    },
    "AssignedBaseline": {
      "additionalProperties": false,
      "description": "The largest verified assigned set a decision hands to its successor window.\n\n``established_at_epoch`` is the close of the window that established it;\n``assigned_identity_digest_sha256`` is the digest of the sorted\n``[uid, hotkey]`` pairs of *registered* miners assigned in that manifest,\nand ``assigned_miner_count`` counts exactly those pairs.",
      "properties": {
        "assigned_identities": {
          "items": {
            "$ref": "#/$defs/RegisteredMiner"
          },
          "maxItems": 4096,
          "title": "Assigned Identities",
          "type": "array"
        },
        "assigned_identity_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assigned Identity Digest Sha256",
          "type": "string"
        },
        "assigned_miner_count": {
          "maximum": 4096,
          "minimum": 0,
          "title": "Assigned Miner Count",
          "type": "integer"
        },
        "established_at_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Established At Epoch",
          "type": "integer"
        },
        "manifest_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Digest Sha256",
          "type": "string"
        },
        "manifest_sequence": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Manifest Sequence",
          "type": "integer"
        }
      },
      "required": [
        "established_at_epoch",
        "manifest_sequence",
        "manifest_digest_sha256",
        "assigned_miner_count",
        "assigned_identity_digest_sha256",
        "assigned_identities"
      ],
      "title": "AssignedBaseline",
      "type": "object"
    },
    "AssignedReplica": {
      "additionalProperties": false,
      "description": "Public-safe projection of one accepted, route-active deployment.v3 assignment.",
      "properties": {
        "assignment_nonce": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Assignment Nonce",
          "type": "string"
        },
        "chain_block": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Chain Block",
          "type": "integer"
        },
        "endpoint_id": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Endpoint Id",
          "type": "string"
        },
        "expires_at_block": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Expires At Block",
          "type": "integer"
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "miner_hotkey": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Miner Hotkey",
          "type": "string"
        },
        "miner_service_public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Miner Service Public Key",
          "type": "string"
        },
        "miner_uid": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Miner Uid",
          "type": "integer"
        },
        "receipt_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Digest Sha256",
          "type": "string"
        },
        "replica_id": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Replica Id",
          "type": "string"
        },
        "route_state": {
          "const": "active",
          "title": "Route State",
          "type": "string"
        },
        "ticket_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ticket Digest Sha256",
          "type": "string"
        },
        "ticket_expires_at_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Ticket Expires At Epoch",
          "type": "integer"
        },
        "ticket_issued_at_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Ticket Issued At Epoch",
          "type": "integer"
        }
      },
      "required": [
        "miner_uid",
        "miner_hotkey",
        "miner_service_public_key",
        "generation",
        "assignment_nonce",
        "replica_id",
        "endpoint_id",
        "ticket_digest_sha256",
        "receipt_digest_sha256",
        "chain_block",
        "expires_at_block",
        "ticket_issued_at_epoch",
        "ticket_expires_at_epoch",
        "route_state"
      ],
      "title": "AssignedReplica",
      "type": "object"
    },
    "ManifestAssignmentEvidence": {
      "additionalProperties": false,
      "description": "One full verified manifest and its immutable scoring linkage.\n\n``scoring_reports`` contains every canonical report in the sealed scoring\nwindow that probed this exact manifest. Keeping the reports themselves,\nrather than a freely remappable list of their digests, lets a parser\nreconstruct the exact :class:`~misscomputer_subnet.probe_scoring.ProbeRound`\nsequence and recompute the scoring-window digest. Together the ordered\nrecords make the registered-only maximum assignment set, terminal set,\nguard, opportunity buckets and successor baseline independently derivable\ninstead of trusting scalar summaries.",
      "properties": {
        "manifest": {
          "$ref": "#/$defs/ActiveAssignmentManifest"
        },
        "scoring_reports": {
          "items": {
            "$ref": "#/$defs/ValidatorProbeReport"
          },
          "maxItems": 4096,
          "title": "Scoring Reports",
          "type": "array"
        }
      },
      "required": [
        "manifest",
        "scoring_reports"
      ],
      "title": "ManifestAssignmentEvidence",
      "type": "object"
    },
    "MinerProbeAttestation": {
      "additionalProperties": false,
      "description": "Miner service-key statement binding one probe nonce to one served payload.",
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "assignment_nonce": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Assignment Nonce",
          "type": "string"
        },
        "deployment_id": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Deployment Id",
          "type": "string"
        },
        "endpoint_id": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Endpoint Id",
          "type": "string"
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "miner_hotkey": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Miner Hotkey",
          "type": "string"
        },
        "miner_service_public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Miner Service Public Key",
          "type": "string"
        },
        "miner_uid": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Miner Uid",
          "type": "integer"
        },
        "probe_nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Probe Nonce",
          "type": "string"
        },
        "purpose": {
          "const": "miner_probe_response_attestation_v1",
          "title": "Purpose",
          "type": "string"
        },
        "response_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Body Sha256",
          "type": "string"
        },
        "response_status": {
          "const": 200,
          "title": "Response Status",
          "type": "integer"
        },
        "route_host": {
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
          "title": "Route Host",
          "type": "string"
        },
        "schema": {
          "const": "miss.computer/misscomputer-subnet/miner-probe-attestation",
          "title": "Schema",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "signature_hex": {
          "pattern": "^[0-9a-f]{128}$",
          "title": "Signature Hex",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schema_version",
        "purpose",
        "algorithm",
        "probe_nonce",
        "route_host",
        "deployment_id",
        "generation",
        "assignment_nonce",
        "endpoint_id",
        "miner_uid",
        "miner_hotkey",
        "miner_service_public_key",
        "response_status",
        "response_body_sha256",
        "signature_hex"
      ],
      "title": "MinerProbeAttestation",
      "type": "object"
    },
    "MinerProbeTally": {
      "additionalProperties": false,
      "description": "What one scoring window observed about one miner identity.",
      "properties": {
        "attributions": {
          "minimum": 0,
          "title": "Attributions",
          "type": "integer"
        },
        "expected_attributions_denominator": {
          "minimum": 1,
          "title": "Expected Attributions Denominator",
          "type": "integer"
        },
        "expected_attributions_numerator": {
          "minimum": 0,
          "title": "Expected Attributions Numerator",
          "type": "integer"
        },
        "hotkey": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Hotkey",
          "type": "string"
        },
        "opportunities": {
          "minimum": 0,
          "title": "Opportunities",
          "type": "integer"
        },
        "replica_share_counts": {
          "items": {
            "$ref": "#/$defs/ReplicaShareCount"
          },
          "maxItems": 8,
          "title": "Replica Share Counts",
          "type": "array"
        },
        "total_latency_millis": {
          "minimum": 0,
          "title": "Total Latency Millis",
          "type": "integer"
        },
        "uid": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Uid",
          "type": "integer"
        }
      },
      "required": [
        "uid",
        "hotkey",
        "opportunities",
        "attributions",
        "expected_attributions_numerator",
        "expected_attributions_denominator",
        "replica_share_counts",
        "total_latency_millis"
      ],
      "title": "MinerProbeTally",
      "type": "object"
    },
    "ProbeObservation": {
      "additionalProperties": false,
      "properties": {
        "assignment_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assignment Digest Sha256",
          "type": "string"
        },
        "attestation": {
          "anyOf": [
            {
              "$ref": "#/$defs/MinerProbeAttestation"
            },
            {
              "type": "null"
            }
          ]
        },
        "attestation_status": {
          "enum": [
            "not_presented",
            "rejected",
            "verified"
          ],
          "title": "Attestation Status",
          "type": "string"
        },
        "build_id_header_verified": {
          "title": "Build Id Header Verified",
          "type": "boolean"
        },
        "challenge_path": {
          "pattern": "^/__challenge/[0-9a-f]{24}$",
          "title": "Challenge Path",
          "type": "string"
        },
        "deployment_id": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Deployment Id",
          "type": "string"
        },
        "failure_code": {
          "anyOf": [
            {
              "enum": [
                "attestation_invalid",
                "attestation_missing",
                "body_digest_mismatch",
                "build_id_header_mismatch",
                "connection_failed",
                "redirect_rejected",
                "response_oversized",
                "timeout",
                "tls_certificate_invalid",
                "tls_handshake_failed",
                "tls_pin_mismatch",
                "transport_error",
                "unexpected_status"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Code"
        },
        "latency_millis": {
          "maximum": 3600000,
          "minimum": 0,
          "title": "Latency Millis",
          "type": "integer"
        },
        "observation_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Digest Sha256",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "failed",
            "serving"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "probe_nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Probe Nonce",
          "type": "string"
        },
        "response_body_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Body Sha256"
        },
        "response_bytes": {
          "maximum": 1048577,
          "minimum": 0,
          "title": "Response Bytes",
          "type": "integer"
        },
        "response_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Status"
        },
        "route_host": {
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
          "title": "Route Host",
          "type": "string"
        },
        "tls_leaf_certificate_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tls Leaf Certificate Sha256"
        }
      },
      "required": [
        "deployment_id",
        "route_host",
        "challenge_path",
        "assignment_digest_sha256",
        "probe_nonce",
        "latency_millis",
        "outcome",
        "failure_code",
        "response_status",
        "response_bytes",
        "response_body_sha256",
        "build_id_header_verified",
        "tls_leaf_certificate_sha256",
        "attestation_status",
        "attestation",
        "observation_digest_sha256"
      ],
      "title": "ProbeObservation",
      "type": "object"
    },
    "ProbeScoringPolicy": {
      "additionalProperties": false,
      "description": "Validator-local scoring parameters.\n\nThese are policy, not consensus: a validator may tune them without breaking\nanything, because each validator scores independently.",
      "properties": {
        "apply_coverage_penalty": {
          "default": true,
          "title": "Apply Coverage Penalty",
          "type": "boolean"
        },
        "latency_target_millis": {
          "default": 1000,
          "maximum": 3600000,
          "minimum": 1,
          "title": "Latency Target Millis",
          "type": "integer"
        },
        "min_attributions": {
          "default": 1,
          "maximum": 4096,
          "minimum": 1,
          "title": "Min Attributions",
          "type": "integer"
        }
      },
      "title": "ProbeScoringPolicy",
      "type": "object"
    },
    "RegisteredMiner": {
      "additionalProperties": false,
      "description": "One metagraph identity eligible to receive weight.\n\nCallers derive these from the finalized snapshot. The validator's own\nhotkey and inactive neurons must be excluded:\n:func:`~misscomputer_subnet.weight_plan.build_weight_plan` rejects a row\nnaming either, and it does so before it looks at the weight, so a zero row\nis not a safe way to mention them.",
      "properties": {
        "hotkey": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Hotkey",
          "type": "string"
        },
        "uid": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Uid",
          "type": "integer"
        }
      },
      "required": [
        "uid",
        "hotkey"
      ],
      "title": "RegisteredMiner",
      "type": "object"
    },
    "ReplicaShareCount": {
      "additionalProperties": false,
      "description": "Opportunity count accumulated at one exact published replica-set size.",
      "properties": {
        "opportunity_count": {
          "minimum": 1,
          "title": "Opportunity Count",
          "type": "integer"
        },
        "replica_count": {
          "maximum": 8,
          "minimum": 1,
          "title": "Replica Count",
          "type": "integer"
        }
      },
