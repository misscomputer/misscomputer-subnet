{
  "$defs": {
    "ServiceKeyBinding": {
      "additionalProperties": false,
      "properties": {
        "challenge": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Challenge",
          "type": "string"
        },
        "expires_at_block": {
          "minimum": 1,
          "title": "Expires At Block",
          "type": "integer"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "hotkey": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Hotkey",
          "type": "string"
        },
        "netuid": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Netuid",
          "type": "integer"
        },
        "network": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Network",
          "type": "string"
        },
        "protocol": {
          "const": "service-binding.v1",
          "default": "service-binding.v1",
          "title": "Protocol",
          "type": "string"
        },
        "role": {
          "enum": [
            "validator",
            "miner"
          ],
          "title": "Role",
          "type": "string"
        },
        "service_public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Service Public Key",
          "type": "string"
        },
        "signature": {
          "default": "",
          "title": "Signature",
          "type": "string"
        },
        "uid": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uid"
        },
        "valid_from_block": {
          "minimum": 0,
          "title": "Valid From Block",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "network",
        "netuid",
        "hotkey",
        "service_public_key",
        "generation",
        "valid_from_block",
        "expires_at_block",
        "challenge"
      ],
      "title": "ServiceKeyBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "axon_url": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Axon Url",
      "type": "string"
    },
    "bridge_url": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Bridge Url",
      "type": "string"
    },
    "hotkey": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Hotkey",
      "type": "string"
    },
    "netuid": {
      "maximum": 65535,
      "minimum": 0,
      "title": "Netuid",
      "type": "integer"
    },
    "network": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Network",
      "type": "string"
    },
    "protocol": {
      "const": "subnet-synapse.v1",
      "title": "Protocol",
      "type": "string"
    },
    "service_binding": {
      "$ref": "#/$defs/ServiceKeyBinding"
    },
    "uid": {
      "anyOf": [
        {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uid"
    }
  },
  "required": [
    "protocol",
    "network",
    "netuid",
    "hotkey",
    "axon_url",
    "bridge_url",
    "service_binding"
  ],
  "title": "MinerRegistration",
  "type": "object"
}
