          "minimum": 0,
          "title": "Bytes Total",
          "type": "integer"
        },
        "ceiling_bytes": {
          "maximum": 1048576,
          "minimum": 1,
          "title": "Ceiling Bytes",
          "type": "integer"
        },
        "deployment_id": {
          "maxLength": 63,
