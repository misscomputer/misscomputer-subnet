              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deployment Id"
        },
        "endpoint_id": {
          "anyOf": [
            {
              "maxLength": 320,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Endpoint Id"
        }
      },
      "required": [
        "code",
        "deployment_id",
        "endpoint_id"
      ],
      "title": "StaticAlert",
      "type": "object"
    },
    "StaticDeploymentCoverage": {
      "additionalProperties": false,
      "description": "\u00a711.3 coverage of one authenticated site: totals, GET-eligible bytes, what was probed.",
      "properties": {
