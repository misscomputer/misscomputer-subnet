          "maximum": 8192,
          "minimum": 0,
          "title": "Routes Body Verified",
          "type": "integer"
        },
        "routes_probed": {
          "maximum": 8192,
          "minimum": 0,
          "title": "Routes Probed",
          "type": "integer"
        },
        "routes_total": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Routes Total",
          "type": "integer"
        },
        "site_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Site Digest",
          "type": "string"
        },
        "unlisted_path_probes": {
          "maximum": 524288,
          "minimum": 0,
          "title": "Unlisted Path Probes",
          "type": "integer"
        }
      },
      "required": [
        "deployment_id",
        "site_digest",
        "release_digest",
        "release_trust_policy_digest_sha256",
        "ceiling_bytes",
        "routes_total",
        "bytes_total",
        "bytes_get_eligible",
        "routes_probed",
        "routes_body_verified",
        "unlisted_path_probes"
      ],
      "title": "StaticDeploymentCoverage",
      "type": "object"
    },
    "StaticDeploymentTarget": {
      "additionalProperties": false,
      "description": "The static bindings of one manifest v3 deployment and its incarnations.\n\nThe manifest v3 verifier owns the authenticity of these fields.",
      "properties": {
        "deployment_id": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Deployment Id",
          "type": "string"
        },
        "endpoints": {
          "items": {
            "$ref": "#/$defs/StaticEndpointTarget"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Endpoints",
          "type": "array"
        },
        "release_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Release Digest",
          "type": "string"
        },
        "route_host": {
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
          "title": "Route Host",
          "type": "string"
        },
        "server_implementation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Server Implementation Digest",
          "type": "string"
        },
        "site_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Site Digest",
          "type": "string"
        }
      },
      "required": [
        "deployment_id",
        "route_host",
        "site_digest",
        "release_digest",
        "server_implementation_digest",
        "endpoints"
      ],
      "title": "StaticDeploymentTarget",
      "type": "object"
    },
