{
  "$defs": {
    "ExternalValidatorIdentity": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "const": true,
          "title": "Active",
          "type": "boolean"
        },
        "hotkey": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Hotkey",
          "type": "string"
        },
        "uid": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Uid",
          "type": "integer"
        },
        "validator_permit": {
          "const": true,
          "title": "Validator Permit",
          "type": "boolean"
        }
      },
      "required": [
        "uid",
        "hotkey",
        "active",
        "validator_permit"
      ],
      "title": "ExternalValidatorIdentity",
      "type": "object"
    },
    "MetagraphMinerMapping": {
      "additionalProperties": false,
      "properties": {
        "hotkey": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Hotkey",
          "type": "string"
        },
        "uid": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Uid",
          "type": "integer"
        }
      },
      "required": [
        "uid",
        "hotkey"
      ],
      "title": "MetagraphMinerMapping",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "finalized": {
      "const": true,
