    "finalized_epoch": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Finalized Epoch",
      "type": "integer"
    },
    "finalized_height": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Finalized Height",
      "type": "integer"
    },
    "metagraph_snapshot_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Metagraph Snapshot Digest Sha256",
      "type": "string"
    },
    "miner_mapping_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Miner Mapping Digest Sha256",
      "type": "string"
    },
    "miner_mappings": {
      "items": {
        "$ref": "#/$defs/MetagraphMinerMapping"
