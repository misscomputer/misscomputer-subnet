{
  "$defs": {
    "MinerProbeAttestationV2": {
      "additionalProperties": false,
      "description": "Miner service-key statement for one validator probe of one organic endpoint.",
      "properties": {
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "endpoint_id": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Endpoint Id",
          "type": "string"
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "observed_at": {
          "maxLength": 64,
          "title": "Observed At",
          "type": "string"
        },
        "probe_nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Probe Nonce",
          "type": "string"
        },
        "request_method": {
          "enum": [
            "GET",
            "HEAD"
          ],
          "title": "Request Method",
          "type": "string"
        },
        "request_path": {
          "maxLength": 1024,
          "pattern": "^/(?:[\\x21\\x22\\x24-\\x2e\\x30-\\x3e\\x40-\\x7e][\\x21\\x22\\x24-\\x3e\\x40-\\x7e]*)?$",
          "title": "Request Path",
          "type": "string"
        },
        "response_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Body Sha256",
          "type": "string"
        },
        "response_header_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Header Sha256",
          "type": "string"
        },
        "response_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Response Status",
          "type": "integer"
        },
        "schema": {
          "const": "miss.computer/misscomputer-subnet/miner-probe-attestation",
          "title": "Schema",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "signature_hex": {
          "pattern": "^[0-9a-f]{128}$",
          "title": "Signature Hex",
          "type": "string"
        },
        "ticket_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Ticket Digest",
          "type": "string"
        },
        "validator_hotkey": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Validator Hotkey",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schema_version",
        "endpoint_id",
        "generation",
        "ticket_digest",
        "artifact_digest",
        "validator_hotkey",
        "probe_nonce",
        "request_method",
        "request_path",
        "response_status",
        "response_body_sha256",
        "response_header_sha256",
        "observed_at",
        "signature_hex"
      ],
      "title": "MinerProbeAttestationV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One sealed attempted probe of one published organic endpoint incarnation.",
  "properties": {
    "assignment_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Assignment Digest Sha256",
      "type": "string"
    },
    "attestation": {
      "anyOf": [
        {
          "$ref": "#/$defs/MinerProbeAttestationV2"
        },
        {
          "type": "null"
        }
      ]
    },
    "attestation_status": {
      "enum": [
        "fraudulent",
        "not_presented",
        "rejected",
        "verified"
      ],
      "title": "Attestation Status",
      "type": "string"
    },
    "attribution": {
      "enum": [
        "application",
        "miner",
        "none",
        "path"
      ],
      "title": "Attribution",
      "type": "string"
    },
    "deployment_id": {
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "title": "Deployment Id",
      "type": "string"
    },
    "endpoint_id": {
      "maxLength": 320,
      "minLength": 3,
      "title": "Endpoint Id",
      "type": "string"
    },
    "failure_code": {
      "anyOf": [
        {
          "enum": [
            "attestation_fraud",
            "attestation_invalid",
            "attestation_missing",
            "connection_failed",
            "edge_generated",
            "marker_missing",
            "response_oversized",
            "timeout",
            "tls_certificate_invalid",
            "tls_handshake_failed",
            "tls_pin_mismatch",
            "transport_error",
            "unexpected_status"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Failure Code"
    },
    "generation": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "issued_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Issued At",
      "type": "string"
    },
    "latency_millis": {
      "maximum": 3600000,
      "minimum": 0,
      "title": "Latency Millis",
      "type": "integer"
    },
    "manifest_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Digest Sha256",
      "type": "string"
    },
    "miner_hotkey": {
      "pattern": "^[A-Za-z0-9]{1,128}$",
      "title": "Miner Hotkey",
      "type": "string"
    },
    "miner_uid": {
      "maximum": 65535,
      "minimum": 0,
      "title": "Miner Uid",
      "type": "integer"
    },
    "observation_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Digest Sha256",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "failure",
        "success"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "probe_nonce": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Probe Nonce",
      "type": "string"
    },
    "request_method": {
      "enum": [
        "GET",
        "HEAD"
      ],
      "title": "Request Method",
      "type": "string"
    },
    "request_path": {
      "maxLength": 1024,
      "pattern": "^/(?:[\\x21\\x22\\x24-\\x2e\\x30-\\x3e\\x40-\\x7e][\\x21\\x22\\x24-\\x3e\\x40-\\x7e]*)?$",
      "title": "Request Path",
      "type": "string"
    },
    "response_body_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Response Body Sha256"
    },
    "response_bytes": {
      "maximum": 1048577,
      "minimum": 0,
      "title": "Response Bytes",
      "type": "integer"
    },
    "response_status": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Response Status"
    },
    "schema": {
      "const": "miss.computer/misscomputer-subnet/organic-probe-observation",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tls_leaf_certificate_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tls Leaf Certificate Sha256"
    },
    "trust_policy_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trust Policy Digest Sha256",
      "type": "string"
    },
    "upstream_marker": {
      "title": "Upstream Marker",
      "type": "boolean"
    },
    "validator_hotkey": {
      "pattern": "^[A-Za-z0-9]{1,128}$",
      "title": "Validator Hotkey",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "validator_hotkey",
    "manifest_digest_sha256",
    "trust_policy_digest_sha256",
    "deployment_id",
    "assignment_digest_sha256",
    "endpoint_id",
    "generation",
    "miner_uid",
    "miner_hotkey",
    "probe_nonce",
    "issued_at",
    "request_method",
    "request_path",
    "latency_millis",
    "outcome",
    "failure_code",
    "attribution",
    "upstream_marker",
    "response_status",
    "response_bytes",
    "response_body_sha256",
    "tls_leaf_certificate_sha256",
    "attestation_status",
    "attestation",
    "observation_digest_sha256"
  ],
  "title": "OrganicProbeObservation",
  "type": "object"
}
