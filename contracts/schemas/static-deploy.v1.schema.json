{
  "$defs": {
    "ServiceKeyBinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "validator"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "transport": {
                "const": "local"
              },
              "transport_certificate_sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "miner"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "transport": {
                "enum": [
                  "https",
                  "http"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "https"
              }
            },
            "required": [
              "transport"
            ]
          },
          "then": {
            "properties": {
              "transport_certificate_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "enum": [
                  "local",
                  "http"
                ]
              }
            },
            "required": [
              "transport"
            ]
          },
          "then": {
            "properties": {
              "transport_certificate_sha256": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "challenge": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Challenge",
          "type": "string"
        },
        "expires_at_block": {
          "minimum": 1,
          "title": "Expires At Block",
          "type": "integer"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "hotkey": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Hotkey",
          "type": "string"
        },
        "netuid": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Netuid",
          "type": "integer"
        },
        "network": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Network",
          "type": "string"
        },
        "protocol": {
          "const": "service-binding.v2",
          "default": "service-binding.v2",
          "title": "Protocol",
          "type": "string"
        },
        "role": {
          "enum": [
            "validator",
            "miner"
          ],
          "title": "Role",
          "type": "string"
        },
        "service_public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Service Public Key",
          "type": "string"
        },
        "signature": {
          "default": "",
          "title": "Signature",
          "type": "string"
        },
        "transport": {
          "enum": [
            "local",
            "https",
            "http"
          ],
          "title": "Transport",
          "type": "string"
        },
        "transport_certificate_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transport Certificate Sha256"
        },
        "uid": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uid"
        },
        "valid_from_block": {
          "minimum": 0,
          "title": "Valid From Block",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "transport",
        "transport_certificate_sha256",
        "network",
        "netuid",
        "hotkey",
        "service_public_key",
        "generation",
        "valid_from_block",
        "expires_at_block",
        "challenge"
      ],
      "title": "ServiceKeyBinding",
      "type": "object"
    },
    "StaticDeploymentTicketV1": {
      "additionalProperties": false,
      "properties": {
        "assignment_nonce": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Assignment Nonce",
          "type": "string"
        },
        "deployment_id": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Deployment Id",
          "type": "string"
        },
        "expires_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Expires At",
          "type": "string"
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "issued_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Issued At",
          "type": "string"
        },
        "miner_id": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Miner Id",
          "type": "string"
        },
        "release_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Release Digest",
          "type": "string"
        },
        "route_host": {
          "maxLength": 253,
          "title": "Route Host",
          "type": "string"
        },
        "schema": {
          "const": "miss.computer/misscomputer-subnet/static-deployment-ticket",
          "title": "Schema",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "server_implementation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Server Implementation Digest",
          "type": "string"
        },
        "signature": {
          "pattern": "^[0-9a-f]{128}$",
          "title": "Signature",
          "type": "string"
        },
        "site_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Site Digest",
          "type": "string"
        },
        "site_manifest_key": {
          "pattern": "^v1/static-sites/[0-9a-f]{64}\\.json$",
          "title": "Site Manifest Key",
          "type": "string"
        },
        "subnet": {
          "$ref": "#/$defs/StaticSubnetBinding"
        },
        "workload_kind": {
          "const": "static-site-v1",
          "title": "Workload Kind",
          "type": "string"
        }
      },
      "required": [
        "assignment_nonce",
        "deployment_id",
        "expires_at",
        "generation",
        "issued_at",
        "miner_id",
        "release_digest",
        "route_host",
        "schema",
        "schema_version",
        "server_implementation_digest",
        "signature",
        "site_digest",
        "site_manifest_key",
        "subnet",
        "workload_kind"
      ],
      "title": "StaticDeploymentTicketV1",
      "type": "object"
    },
    "StaticSubnetBinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "miner_transport": {
                "const": "https"
              }
            },
            "required": [
              "miner_transport"
            ]
          },
          "then": {
            "properties": {
              "miner_tls_certificate_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "miner_transport": {
                "const": "http"
              }
            },
            "required": [
              "miner_transport"
            ]
          },
          "then": {
            "properties": {
              "miner_tls_certificate_sha256": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "The deployment.v4 subnet binding with ``miner_uid`` always present.",
      "properties": {
        "chain_block": {
          "minimum": 0,
          "title": "Chain Block",
          "type": "integer"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "expires_at_block": {
          "minimum": 1,
          "title": "Expires At Block",
          "type": "integer"
        },
        "miner_axon_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Miner Axon Url",
          "type": "string"
        },
        "miner_hotkey": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Miner Hotkey",
          "type": "string"
        },
        "miner_service_public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Miner Service Public Key",
          "type": "string"
        },
        "miner_tls_certificate_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Miner Tls Certificate Sha256"
        },
        "miner_transport": {
          "enum": [
            "https",
            "http"
          ],
          "title": "Miner Transport",
          "type": "string"
        },
        "miner_uid": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Miner Uid"
        },
        "netuid": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Netuid",
          "type": "integer"
        },
        "network": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Network",
          "type": "string"
        },
        "validator_hotkey": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Validator Hotkey",
          "type": "string"
        },
        "validator_service_public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validator Service Public Key",
          "type": "string"
        }
      },
      "required": [
        "network",
        "netuid",
        "validator_hotkey",
        "miner_hotkey",
        "miner_uid",
        "miner_axon_url",
        "miner_transport",
        "miner_tls_certificate_sha256",
        "chain_block",
        "epoch",
        "expires_at_block",
        "validator_service_public_key",
        "miner_service_public_key"
      ],
      "title": "StaticSubnetBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Validator -> miner static assignment (the DeploySynapseV3 shape).",
  "properties": {
    "caller_hotkey": {
      "pattern": "^[A-Za-z0-9]{1,128}$",
      "title": "Caller Hotkey",
      "type": "string"
    },
    "current_block": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Current Block",
      "type": "integer"
    },
    "protocol": {
      "const": "subnet-static-synapse.v1",
      "title": "Protocol",
      "type": "string"
    },
    "request_id": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "ticket": {
      "$ref": "#/$defs/StaticDeploymentTicketV1"
    },
    "validator_binding": {
      "$ref": "#/$defs/ServiceKeyBinding"
    }
  },
  "required": [
    "protocol",
    "request_id",
    "current_block",
    "caller_hotkey",
    "validator_binding",
    "ticket"
  ],
  "title": "StaticDeploySynapseV1",
  "type": "object"
}
