          "type": "string"
        },
        "key_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$",
          "title": "Key Id",
          "type": "string"
        },
        "public_key_base64": {
          "maxLength": 44,
          "minLength": 44,
          "title": "Public Key Base64",
          "type": "string"
        },
        "public_key_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Public Key Sha256",
          "type": "string"
        },
        "purposes": {
          "items": {
            "const": "central_score_checkpoint_weight_relay_v1",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Purposes",
          "type": "array"
        },
        "revoked_at_epoch": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revoked At Epoch"
        },
        "roles": {
          "items": {
            "enum": [
              "checkpoint_auditor",
              "checkpoint_issuer",
              "checkpoint_security"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "valid_from_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Valid From Epoch",
          "type": "integer"
        },
        "valid_until_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Valid Until Epoch",
          "type": "integer"
        }
      },
      "required": [
        "key_id",
        "algorithm",
        "public_key_base64",
        "public_key_sha256",
        "roles",
        "purposes",
        "valid_from_epoch",
        "valid_until_epoch",
        "revoked_at_epoch"
      ],
      "title": "TrustedCheckpointKey",
      "type": "object"
