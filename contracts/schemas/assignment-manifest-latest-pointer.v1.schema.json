{
  "additionalProperties": false,
  "description": "The only mutable publication object: which immutable manifest is current.",
  "properties": {
    "central_authority_fingerprint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Central Authority Fingerprint Sha256",
      "type": "string"
    },
    "expires_at_epoch": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Expires At Epoch",
      "type": "integer"
    },
    "finalized_block_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Finalized Block Hash",
      "type": "string"
    },
    "finalized_epoch": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Finalized Epoch",
      "type": "integer"
    },
    "finalized_height": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Finalized Height",
      "type": "integer"
    },
    "issued_at_epoch": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Issued At Epoch",
      "type": "integer"
    },
    "manifest_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Digest Sha256",
      "type": "string"
    },
    "manifest_object_key": {
      "maxLength": 82,
      "minLength": 82,
      "pattern": "^v1/manifests/[0-9a-f]{64}\\.json$",
      "title": "Manifest Object Key",
      "type": "string"
    },
    "netuid": {
      "const": 24,
      "title": "Netuid",
      "type": "integer"
    },
    "network": {
      "const": "finney",
      "title": "Network",
      "type": "string"
    },
    "pointer_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pointer Digest Sha256",
      "type": "string"
    },
    "previous_manifest_digest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Manifest Digest Sha256"
    },
    "purpose": {
      "const": "active_assignment_manifest_publication_v1",
      "title": "Purpose",
      "type": "string"
    },
    "schema": {
      "const": "miss.computer/misscomputer-subnet/assignment-manifest-latest-pointer",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "signer_key_ids": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Signer Key Ids",
      "type": "array"
    },
    "trust_policy_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trust Policy Digest Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "purpose",
    "network",
    "netuid",
    "central_authority_fingerprint_sha256",
    "trust_policy_digest_sha256",
    "sequence",
    "previous_manifest_digest_sha256",
    "manifest_digest_sha256",
    "finalized_height",
    "finalized_block_hash",
    "finalized_epoch",
    "issued_at_epoch",
    "expires_at_epoch",
    "manifest_object_key",
    "signer_key_ids",
    "pointer_digest_sha256"
  ],
  "title": "AssignmentManifestLatestPointer",
  "type": "object"
}
