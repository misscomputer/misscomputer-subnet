      "type": "integer"
    },
    "component_totals": {
      "$ref": "#/$defs/ScoreComponentTotals"
    },
    "eligibility_status": {
      "enum": [
        "eligible",
        "ineligible"
      ],
      "title": "Eligibility Status",
      "type": "string"
    },
    "evidence_content_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Content Digest Sha256",
      "type": "string"
    },
    "failure_penalty_ppm": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Failure Penalty Ppm",
      "type": "integer"
    },
