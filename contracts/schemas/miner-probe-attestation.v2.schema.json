{
  "additionalProperties": false,
  "description": "Miner service-key statement for one validator probe of one organic endpoint.",
  "properties": {
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    },
    "endpoint_id": {
      "maxLength": 320,
      "minLength": 3,
      "title": "Endpoint Id",
      "type": "string"
    },
    "generation": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "observed_at": {
      "maxLength": 64,
      "title": "Observed At",
      "type": "string"
    },
    "probe_nonce": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Probe Nonce",
      "type": "string"
    },
    "request_method": {
      "enum": [
        "GET",
        "HEAD"
      ],
      "title": "Request Method",
      "type": "string"
    },
    "request_path": {
      "maxLength": 1024,
      "pattern": "^/(?:[\\x21\\x22\\x24-\\x2e\\x30-\\x3e\\x40-\\x7e][\\x21\\x22\\x24-\\x3e\\x40-\\x7e]*)?$",
      "title": "Request Path",
      "type": "string"
    },
    "response_body_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Response Body Sha256",
      "type": "string"
    },
    "response_header_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Response Header Sha256",
      "type": "string"
    },
    "response_status": {
      "maximum": 599,
      "minimum": 100,
      "title": "Response Status",
      "type": "integer"
    },
    "schema": {
      "const": "miss.computer/misscomputer-subnet/miner-probe-attestation",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "signature_hex": {
      "pattern": "^[0-9a-f]{128}$",
      "title": "Signature Hex",
      "type": "string"
    },
    "ticket_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Ticket Digest",
      "type": "string"
    },
    "validator_hotkey": {
      "pattern": "^[A-Za-z0-9]{1,128}$",
      "title": "Validator Hotkey",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "endpoint_id",
    "generation",
    "ticket_digest",
    "artifact_digest",
    "validator_hotkey",
    "probe_nonce",
    "request_method",
    "request_path",
    "response_status",
    "response_body_sha256",
    "response_header_sha256",
    "observed_at",
    "signature_hex"
  ],
  "title": "MinerProbeAttestationV2",
  "type": "object"
}
