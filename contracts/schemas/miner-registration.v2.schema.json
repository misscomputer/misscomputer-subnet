{
  "$defs": {
    "ServiceKeyBinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "validator"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "transport": {
                "const": "local"
              },
              "transport_certificate_sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "miner"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "transport": {
                "enum": [
                  "https",
                  "http"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "https"
              }
            },
            "required": [
              "transport"
            ]
          },
          "then": {
            "properties": {
              "transport_certificate_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "enum": [
                  "local",
                  "http"
                ]
              }
            },
            "required": [
              "transport"
            ]
          },
          "then": {
            "properties": {
              "transport_certificate_sha256": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "challenge": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Challenge",
          "type": "string"
        },
        "expires_at_block": {
          "minimum": 1,
          "title": "Expires At Block",
          "type": "integer"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "hotkey": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Hotkey",
          "type": "string"
        },
        "netuid": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Netuid",
          "type": "integer"
        },
        "network": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Network",
          "type": "string"
        },
        "protocol": {
          "const": "service-binding.v2",
          "default": "service-binding.v2",
          "title": "Protocol",
          "type": "string"
        },
        "role": {
          "enum": [
            "validator",
            "miner"
          ],
          "title": "Role",
          "type": "string"
        },
        "service_public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Service Public Key",
          "type": "string"
        },
        "signature": {
          "default": "",
          "title": "Signature",
          "type": "string"
        },
        "transport": {
          "enum": [
            "local",
            "https",
            "http"
          ],
          "title": "Transport",
          "type": "string"
        },
        "transport_certificate_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transport Certificate Sha256"
        },
        "uid": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uid"
        },
        "valid_from_block": {
          "minimum": 0,
          "title": "Valid From Block",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "transport",
        "transport_certificate_sha256",
        "network",
        "netuid",
        "hotkey",
        "service_public_key",
        "generation",
        "valid_from_block",
        "expires_at_block",
        "challenge"
      ],
      "title": "ServiceKeyBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "service_binding": {
            "properties": {
              "transport": {
                "const": "https"
              }
            },
            "required": [
              "transport"
            ]
          }
        },
        "required": [
          "service_binding"
        ]
      },
      "then": {
        "properties": {
          "transport_certificate_der_base64": {
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "service_binding": {
            "properties": {
              "transport": {
                "const": "http"
              }
            },
            "required": [
              "transport"
            ]
          }
        },
        "required": [
          "service_binding"
        ]
      },
      "then": {
        "properties": {
          "transport_certificate_der_base64": {
            "const": ""
          }
        }
      }
    }
  ],
  "properties": {
    "axon_url": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Axon Url",
      "type": "string"
    },
    "bridge_url": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Bridge Url",
      "type": "string"
    },
    "hotkey": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Hotkey",
      "type": "string"
    },
    "netuid": {
      "maximum": 65535,
      "minimum": 0,
      "title": "Netuid",
      "type": "integer"
    },
    "network": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Network",
      "type": "string"
    },
    "protocol": {
      "const": "subnet-synapse.v2",
      "title": "Protocol",
      "type": "string"
    },
    "service_binding": {
      "$ref": "#/$defs/ServiceKeyBinding"
    },
    "transport_certificate_der_base64": {
      "title": "Transport Certificate Der Base64",
      "type": "string"
    },
    "uid": {
      "anyOf": [
        {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uid"
    }
  },
  "required": [
    "protocol",
    "network",
    "netuid",
    "hotkey",
    "axon_url",
    "bridge_url",
    "service_binding",
    "transport_certificate_der_base64"
  ],
  "title": "MinerRegistration",
  "type": "object"
}
