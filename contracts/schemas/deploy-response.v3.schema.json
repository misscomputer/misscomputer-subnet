{
  "$defs": {
    "DeploymentReceiptV4": {
      "additionalProperties": false,
      "properties": {
        "assignment_nonce": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Assignment Nonce",
          "type": "string"
        },
        "assignment_seen": {
          "maxLength": 64,
          "title": "Assignment Seen",
          "type": "string"
        },
        "deployment_id": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Deployment Id",
          "type": "string"
        },
        "endpoint_id": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Endpoint Id",
          "type": "string"
        },
        "error": {
          "maxLength": 512,
          "pattern": "^[\\x20-\\x7e]*$",
          "title": "Error",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "artifact_fetch_failed",
                "artifact_verify_failed",
                "image_load_failed",
                "image_identity_mismatch",
                "container_create_failed",
                "container_exited",
                "health_timeout",
                "health_unexpected_status",
                "health_marker_missing",
                "resource_exhausted",
                "deactivated",
                "internal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "health_passed": {
          "maxLength": 64,
          "title": "Health Passed",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "loaded_image_config_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Loaded Image Config Digest"
        },
        "manifest_key": {
          "pattern": "^v1/manifests/[0-9a-f]{64}\\.json$",
          "title": "Manifest Key",
          "type": "string"
        },
        "miner_id": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Miner Id",
          "type": "string"
        },
        "pull_completed": {
          "maxLength": 64,
          "title": "Pull Completed",
          "type": "string"
        },
        "pull_started": {
          "maxLength": 64,
          "title": "Pull Started",
          "type": "string"
        },
        "replica_id": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Replica Id",
          "type": "string"
        },
        "route_host": {
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
          "title": "Route Host",
          "type": "string"
        },
        "runtime_started": {
          "maxLength": 64,
          "title": "Runtime Started",
          "type": "string"
        },
        "signature": {
          "pattern": "^[0-9a-f]{128}$",
          "title": "Signature",
          "type": "string"
        },
        "stage": {
          "enum": [
            "accepted",
            "ready",
            "failed"
          ],
          "title": "Stage",
          "type": "string"
        },
        "subnet": {
          "$ref": "#/$defs/SubnetBinding"
        },
        "version": {
          "const": "deployment.v4",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "deployment_id",
        "generation",
        "assignment_nonce",
        "miner_id",
        "replica_id",
        "endpoint_id",
        "image_digest",
        "manifest_key",
        "loaded_image_config_digest",
        "route_host",
        "stage",
        "error_code",
        "error",
        "assignment_seen",
        "pull_started",
        "pull_completed",
        "runtime_started",
        "health_passed",
        "subnet",
        "signature"
      ],
      "title": "DeploymentReceiptV4",
      "type": "object"
    },
    "MinerResultV4": {
      "additionalProperties": false,
      "properties": {
        "endpoint_id": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Endpoint Id",
          "type": "string"
        },
        "receipt": {
          "$ref": "#/$defs/DeploymentReceiptV4"
        }
      },
      "required": [
        "receipt",
        "endpoint_id"
      ],
      "title": "MinerResultV4",
      "type": "object"
    },
    "SubnetBinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "miner_transport": {
                "const": "https"
              }
            },
            "required": [
              "miner_transport"
            ]
          },
          "then": {
            "properties": {
              "miner_tls_certificate_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "miner_transport": {
                "const": "http"
              }
            },
            "required": [
              "miner_transport"
            ]
          },
          "then": {
            "properties": {
              "miner_tls_certificate_sha256": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "chain_block": {
          "minimum": 0,
          "title": "Chain Block",
          "type": "integer"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "expires_at_block": {
          "minimum": 1,
          "title": "Expires At Block",
          "type": "integer"
        },
        "miner_axon_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Miner Axon Url",
          "type": "string"
        },
        "miner_hotkey": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Miner Hotkey",
          "type": "string"
        },
        "miner_service_public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Miner Service Public Key",
          "type": "string"
        },
        "miner_tls_certificate_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Miner Tls Certificate Sha256"
        },
        "miner_transport": {
          "enum": [
            "https",
            "http"
          ],
          "title": "Miner Transport",
          "type": "string"
        },
        "miner_uid": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Miner Uid"
        },
        "netuid": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Netuid",
          "type": "integer"
        },
        "network": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Network",
          "type": "string"
        },
        "validator_hotkey": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Validator Hotkey",
          "type": "string"
        },
        "validator_service_public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validator Service Public Key",
          "type": "string"
        }
      },
      "required": [
        "network",
        "netuid",
        "validator_hotkey",
        "miner_hotkey",
        "miner_axon_url",
        "miner_transport",
        "miner_tls_certificate_sha256",
        "chain_block",
        "epoch",
        "expires_at_block",
        "validator_service_public_key",
        "miner_service_public_key"
      ],
      "title": "SubnetBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "idempotent": {
      "title": "Idempotent",
      "type": "boolean"
    },
    "protocol": {
      "const": "subnet-synapse.v3",
      "title": "Protocol",
      "type": "string"
    },
    "request_id": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/MinerResultV4"
    }
  },
  "required": [
    "protocol",
    "request_id",
    "result",
    "idempotent"
  ],
  "title": "DeployResponseV3",
  "type": "object"
}
