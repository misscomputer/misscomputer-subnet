{
  "$defs": {
    "MinerProbeAttestationV2": {
      "additionalProperties": false,
      "description": "Miner service-key statement for one validator probe of one organic endpoint.",
      "properties": {
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "endpoint_id": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Endpoint Id",
          "type": "string"
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "observed_at": {
          "maxLength": 64,
          "title": "Observed At",
          "type": "string"
        },
        "probe_nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Probe Nonce",
          "type": "string"
        },
        "request_method": {
          "enum": [
            "GET",
            "HEAD"
          ],
          "title": "Request Method",
          "type": "string"
        },
        "request_path": {
          "maxLength": 1024,
          "pattern": "^/(?:[\\x21\\x22\\x24-\\x2e\\x30-\\x3e\\x40-\\x7e][\\x21\\x22\\x24-\\x3e\\x40-\\x7e]*)?$",
          "title": "Request Path",
          "type": "string"
        },
        "response_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Body Sha256",
          "type": "string"
        },
        "response_header_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Header Sha256",
          "type": "string"
        },
        "response_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Response Status",
          "type": "integer"
        },
        "schema": {
          "const": "miss.computer/misscomputer-subnet/miner-probe-attestation",
          "title": "Schema",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "signature_hex": {
          "pattern": "^[0-9a-f]{128}$",
          "title": "Signature Hex",
          "type": "string"
        },
        "ticket_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Ticket Digest",
          "type": "string"
        },
        "validator_hotkey": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Validator Hotkey",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schema_version",
        "endpoint_id",
        "generation",
        "ticket_digest",
        "artifact_digest",
        "validator_hotkey",
        "probe_nonce",
        "request_method",
        "request_path",
        "response_status",
        "response_body_sha256",
        "response_header_sha256",
        "observed_at",
        "signature_hex"
      ],
      "title": "MinerProbeAttestationV2",
      "type": "object"
    },
    "StaticProbeObservation": {
      "additionalProperties": false,
      "description": "One sealed attempted request to one static endpoint incarnation.",
      "properties": {
        "attestation": {
          "anyOf": [
            {
              "$ref": "#/$defs/MinerProbeAttestationV2"
            },
            {
              "type": "null"
            }
          ]
        },
        "attestation_status": {
          "enum": [
            "fraudulent",
            "not_presented",
            "rejected",
            "replayed",
            "verified"
          ],
          "title": "Attestation Status",
          "type": "string"
        },
        "attribution": {
          "enum": [
            "miner",
            "none",
            "path"
          ],
          "title": "Attribution",
          "type": "string"
        },
        "delivered_headers": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivered Headers"
        },
        "delivered_http_version": {
          "anyOf": [
            {
              "enum": [
                "HTTP/1.1",
                "HTTP/2",
                "HTTP/3"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivered Http Version"
        },
        "deployment_id": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Deployment Id",
          "type": "string"
        },
        "endpoint_id": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Endpoint Id",
          "type": "string"
        },
        "expected_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Body Sha256",
          "type": "string"
        },
        "expected_content_length": {
          "maximum": 16777216,
          "minimum": 0,
          "title": "Expected Content Length",
          "type": "integer"
        },
        "expected_header_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Header Sha256",
          "type": "string"
        },
        "expected_kind": {
          "enum": [
            "directory_index",
            "file",
            "navigation_fallback",
            "not_found"
          ],
          "title": "Expected Kind",
          "type": "string"
        },
        "expected_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Expected Status",
          "type": "integer"
        },
        "failure_code": {
          "anyOf": [
            {
              "enum": [
                "attestation_fraud",
                "attestation_invalid",
                "attestation_missing",
                "body_mismatch",
                "cache_replay",
                "connection_failed",
                "content_altered_in_transit",
                "edge_generated",
                "forbidden_header",
                "header_mismatch",
                "response_oversized",
                "status_mismatch",
                "timeout",
                "tls_certificate_invalid",
                "tls_handshake_failed",
                "tls_pin_mismatch",
                "transport_error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Code"
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "issued_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Issued At",
          "type": "string"
        },
        "latency_millis": {
          "maximum": 3600000,
          "minimum": 0,
          "title": "Latency Millis",
          "type": "integer"
        },
        "miner_hotkey": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Miner Hotkey",
          "type": "string"
        },
        "miner_uid": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Miner Uid",
          "type": "integer"
        },
        "observation_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Digest Sha256",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "failure",
            "success"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "probe_kind": {
          "enum": [
            "admission",
            "hidden"
          ],
          "title": "Probe Kind",
          "type": "string"
        },
        "probe_nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Probe Nonce",
          "type": "string"
        },
        "quarantine_candidate": {
          "title": "Quarantine Candidate",
          "type": "boolean"
        },
        "release_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Release Digest",
          "type": "string"
        },
        "release_trust_policy_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Trust Policy Digest Sha256",
          "type": "string"
        },
        "request_method": {
          "enum": [
            "GET",
            "HEAD"
          ],
          "title": "Request Method",
          "type": "string"
        },
        "request_path": {
          "maxLength": 1024,
          "pattern": "^/(?:[\\x21\\x22\\x24-\\x2e\\x30-\\x3e\\x40-\\x7e][\\x21\\x22\\x24-\\x3e\\x40-\\x7e]*)?$",
          "title": "Request Path",
          "type": "string"
        },
        "response_body_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Body Sha256"
        },
        "response_bytes": {
          "maximum": 16777217,
          "minimum": 0,
          "title": "Response Bytes",
          "type": "integer"
        },
        "response_header_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Header Sha256"
        },
        "response_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Status"
        },
        "schema": {
          "const": "miss.computer/misscomputer-subnet/static-probe-observation",
          "title": "Schema",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            1,
            2
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "site_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Site Digest",
          "type": "string"
        },
        "tls_leaf_certificate_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tls Leaf Certificate Sha256"
        },
        "transport_policy_digest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Policy Digest Sha256"
        },
        "transport_profile": {
          "anyOf": [
            {
              "const": "public-framing-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Profile"
        },
        "upstream_marker": {
          "title": "Upstream Marker",
          "type": "boolean"
        },
        "validator_hotkey": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Validator Hotkey",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schema_version",
        "probe_kind",
        "validator_hotkey",
        "deployment_id",
        "site_digest",
        "release_digest",
        "release_trust_policy_digest_sha256",
        "endpoint_id",
        "generation",
        "miner_uid",
        "miner_hotkey",
        "probe_nonce",
        "issued_at",
        "request_method",
        "request_path",
        "expected_kind",
        "expected_status",
        "expected_content_length",
        "expected_body_sha256",
        "expected_header_sha256",
        "latency_millis",
        "outcome",
        "failure_code",
        "attribution",
        "quarantine_candidate",
        "upstream_marker",
        "response_status",
        "response_bytes",
        "response_body_sha256",
        "response_header_sha256",
        "tls_leaf_certificate_sha256",
        "attestation_status",
        "attestation",
        "observation_digest_sha256"
      ],
      "title": "StaticProbeObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``static-evidence-record`` v1: one journal entry chained to its predecessor.",
  "properties": {
    "observation": {
      "$ref": "#/$defs/StaticProbeObservation"
    },
    "prior_record_digest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prior Record Digest Sha256"
    },
    "record_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Digest Sha256",
      "type": "string"
    },
    "record_index": {
      "maximum": 1048576,
      "minimum": 1,
      "title": "Record Index",
      "type": "integer"
    },
    "schema": {
      "const": "miss.computer/misscomputer-subnet/static-evidence-record",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1,
        2
      ],
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "record_index",
    "prior_record_digest_sha256",
    "observation",
    "record_digest_sha256"
  ],
  "title": "StaticEvidenceRecord",
  "type": "object"
}
