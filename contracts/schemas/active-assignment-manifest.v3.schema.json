{
  "$defs": {
    "OciDeploymentAssignmentV3": {
      "additionalProperties": false,
      "description": "An ``oci-image-v1`` deployment: the v2 deployment plus null static bindings.",
      "properties": {
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "assignment_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assignment Digest Sha256",
          "type": "string"
        },
        "attestation_requirement": {
          "const": "miner_service_key_v2",
          "title": "Attestation Requirement",
          "type": "string"
        },
        "deployment_id": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Deployment Id",
          "type": "string"
        },
        "health": {
          "$ref": "#/$defs/OrganicHealthProbe"
        },
        "release_digest": {
          "title": "Release Digest",
          "type": "null"
        },
        "replicas": {
          "items": {
            "$ref": "#/$defs/OrganicAssignedReplica"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Replicas",
          "type": "array"
        },
        "route_host": {
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
          "title": "Route Host",
          "type": "string"
        },
        "server_implementation_digest": {
          "title": "Server Implementation Digest",
          "type": "null"
        },
        "site_digest": {
          "title": "Site Digest",
          "type": "null"
        },
        "workload_kind": {
          "const": "oci-image-v1",
          "title": "Workload Kind",
          "type": "string"
        }
      },
      "required": [
        "deployment_id",
        "route_host",
        "attestation_requirement",
        "replicas",
        "assignment_digest_sha256",
        "workload_kind",
        "artifact_digest",
        "health",
        "site_digest",
        "release_digest",
        "server_implementation_digest"
      ],
      "title": "OciDeploymentAssignmentV3",
      "type": "object"
    },
    "OrganicAssignedReplica": {
      "additionalProperties": false,
      "properties": {
        "activated_at_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Activated At Epoch",
          "type": "integer"
        },
        "assignment_nonce": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Assignment Nonce",
          "type": "string"
        },
        "chain_block": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Chain Block",
          "type": "integer"
        },
        "endpoint_id": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Endpoint Id",
          "type": "string"
        },
        "expires_at_block": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Expires At Block",
          "type": "integer"
        },
        "expires_at_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Expires At Epoch",
          "type": "integer"
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "miner_hotkey": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Miner Hotkey",
          "type": "string"
        },
        "miner_service_public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Miner Service Public Key",
          "type": "string"
        },
        "miner_tls_certificate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Miner Tls Certificate Sha256",
          "type": "string"
        },
        "miner_uid": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Miner Uid",
          "type": "integer"
        },
        "receipt_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Receipt Digest",
          "type": "string"
        },
        "replica_id": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Replica Id",
          "type": "string"
        },
        "route_state": {
          "const": "active",
          "title": "Route State",
          "type": "string"
        },
        "ticket_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Ticket Digest",
          "type": "string"
        }
      },
      "required": [
        "miner_uid",
        "miner_hotkey",
        "miner_service_public_key",
        "miner_tls_certificate_sha256",
        "generation",
        "assignment_nonce",
        "replica_id",
        "endpoint_id",
        "ticket_digest",
        "receipt_digest",
        "chain_block",
        "expires_at_block",
        "activated_at_epoch",
        "expires_at_epoch",
        "route_state"
      ],
      "title": "OrganicAssignedReplica",
      "type": "object"
    },
    "OrganicHealthProbe": {
      "additionalProperties": false,
      "description": "Sanitized public health predicate published for hidden validator probes.",
      "properties": {
        "expected_statuses": {
          "items": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Expected Statuses",
          "type": "array"
        },
        "method": {
          "enum": [
            "GET",
            "HEAD"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "pattern": "^/(?:[\\x21\\x22\\x24-\\x2e\\x30-\\x3e\\x40-\\x7e][\\x21\\x22\\x24-\\x3e\\x40-\\x7e]*)?$",
          "title": "Path",
          "type": "string"
        },
        "response_marker": {
          "anyOf": [
            {
              "pattern": "^[\\x20-\\x7e]{1,256}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Response Marker"
        }
      },
      "required": [
        "method",
        "path",
        "expected_statuses",
        "response_marker"
      ],
      "title": "OrganicHealthProbe",
      "type": "object"
    },
    "StaticDeploymentAssignmentV3": {
      "additionalProperties": false,
      "description": "A ``static-site-v1`` deployment; probes derive from its signed site manifest.\n\nEvery replica shares the deployment's ``site_digest``; its ``ticket_digest``\nand ``receipt_digest`` are the static ticket and receipt v1 digests.",
      "properties": {
        "artifact_digest": {
          "title": "Artifact Digest",
          "type": "null"
        },
        "assignment_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assignment Digest Sha256",
          "type": "string"
        },
        "attestation_requirement": {
          "const": "miner_service_key_v2",
          "title": "Attestation Requirement",
          "type": "string"
        },
        "deployment_id": {
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Deployment Id",
          "type": "string"
        },
        "health": {
          "title": "Health",
          "type": "null"
        },
        "release_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Release Digest",
          "type": "string"
        },
        "replicas": {
          "items": {
            "$ref": "#/$defs/OrganicAssignedReplica"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Replicas",
          "type": "array"
        },
        "route_host": {
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
          "title": "Route Host",
          "type": "string"
        },
        "server_implementation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Server Implementation Digest",
          "type": "string"
        },
        "site_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Site Digest",
          "type": "string"
        },
        "workload_kind": {
          "const": "static-site-v1",
          "title": "Workload Kind",
          "type": "string"
        }
      },
      "required": [
        "deployment_id",
        "route_host",
        "attestation_requirement",
        "replicas",
        "assignment_digest_sha256",
        "workload_kind",
        "artifact_digest",
        "health",
        "site_digest",
        "release_digest",
        "server_implementation_digest"
      ],
      "title": "StaticDeploymentAssignmentV3",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Public snapshot of active OCI and static miner routes after verified cutover.\n\nThe v2 header and publication rules with the v3 purpose and signing\ndomain; every deployment names an explicit ``workload_kind`` (static-site\ncontract \u00a711.1). A v2 manifest never carries a static deployment.",
  "properties": {
    "assignment_vector_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Assignment Vector Digest Sha256",
      "type": "string"
    },
    "central_authority_fingerprint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Central Authority Fingerprint Sha256",
      "type": "string"
    },
    "deployments": {
      "items": {
        "discriminator": {
          "mapping": {
            "oci-image-v1": "#/$defs/OciDeploymentAssignmentV3",
            "static-site-v1": "#/$defs/StaticDeploymentAssignmentV3"
          },
          "propertyName": "workload_kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/OciDeploymentAssignmentV3"
          },
          {
            "$ref": "#/$defs/StaticDeploymentAssignmentV3"
          }
        ]
      },
      "maxItems": 4096,
      "title": "Deployments",
      "type": "array"
    },
    "expires_at_epoch": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Expires At Epoch",
      "type": "integer"
    },
    "finalized_block_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Finalized Block Hash",
      "type": "string"
    },
    "finalized_epoch": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Finalized Epoch",
      "type": "integer"
    },
    "finalized_height": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Finalized Height",
      "type": "integer"
    },
    "issued_at_epoch": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Issued At Epoch",
      "type": "integer"
    },
    "manifest_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Digest Sha256",
      "type": "string"
    },
    "netuid": {
      "const": 24,
      "title": "Netuid",
      "type": "integer"
    },
    "network": {
      "const": "finney",
      "title": "Network",
      "type": "string"
    },
    "previous_manifest_digest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Manifest Digest Sha256"
    },
    "probe_port": {
      "maximum": 65535,
      "minimum": 1,
      "title": "Probe Port",
      "type": "integer"
    },
    "probe_scheme": {
      "const": "https",
      "title": "Probe Scheme",
      "type": "string"
    },
    "purpose": {
      "const": "active_assignment_manifest_publication_v3",
      "title": "Purpose",
      "type": "string"
    },
    "route_host_suffix": {
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
      "title": "Route Host Suffix",
      "type": "string"
    },
    "schema": {
      "const": "miss.computer/misscomputer-subnet/active-assignment-manifest",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "trust_policy_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trust Policy Digest Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "purpose",
    "network",
    "netuid",
    "central_authority_fingerprint_sha256",
    "trust_policy_digest_sha256",
    "finalized_height",
    "finalized_block_hash",
    "finalized_epoch",
    "sequence",
    "previous_manifest_digest_sha256",
    "issued_at_epoch",
    "expires_at_epoch",
    "route_host_suffix",
    "probe_scheme",
    "probe_port",
    "deployments",
    "assignment_vector_digest_sha256",
    "manifest_digest_sha256"
  ],
  "title": "ActiveAssignmentManifestV3",
  "type": "object"
}
