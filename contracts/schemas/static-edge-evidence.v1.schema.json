{
  "$defs": {
    "MinerProbeAttestationV2": {
      "additionalProperties": false,
      "description": "Miner service-key statement for one validator probe of one organic endpoint.",
      "properties": {
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "endpoint_id": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Endpoint Id",
          "type": "string"
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "observed_at": {
          "maxLength": 64,
          "title": "Observed At",
          "type": "string"
        },
        "probe_nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Probe Nonce",
          "type": "string"
        },
        "request_method": {
          "enum": [
            "GET",
            "HEAD"
          ],
          "title": "Request Method",
          "type": "string"
        },
        "request_path": {
          "maxLength": 1024,
          "pattern": "^/(?:[\\x21\\x22\\x24-\\x2e\\x30-\\x3e\\x40-\\x7e][\\x21\\x22\\x24-\\x3e\\x40-\\x7e]*)?$",
          "title": "Request Path",
          "type": "string"
        },
        "response_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Body Sha256",
          "type": "string"
        },
        "response_header_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Header Sha256",
          "type": "string"
        },
        "response_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Response Status",
          "type": "integer"
        },
        "schema": {
          "const": "miss.computer/misscomputer-subnet/miner-probe-attestation",
          "title": "Schema",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "signature_hex": {
          "pattern": "^[0-9a-f]{128}$",
          "title": "Signature Hex",
          "type": "string"
        },
        "ticket_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Ticket Digest",
          "type": "string"
        },
        "validator_hotkey": {
          "pattern": "^[A-Za-z0-9]{1,128}$",
          "title": "Validator Hotkey",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schema_version",
        "endpoint_id",
        "generation",
        "ticket_digest",
        "artifact_digest",
        "validator_hotkey",
        "probe_nonce",
        "request_method",
        "request_path",
        "response_status",
        "response_body_sha256",
        "response_header_sha256",
        "observed_at",
        "signature_hex"
      ],
      "title": "MinerProbeAttestationV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``static-edge-evidence`` v1: one durable edge check of one static response.\n\n``verdict`` must follow from the facts: ``pass`` needs a complete\nreplica-marked response equal to the expectation; ``content_fault`` a\ncomplete replica-marked response that differs from it; ``path_fault``\nanything incomplete or not replica-marked. Digests use the contract's\n``sha256:``-prefixed ``site_digest``/``release_digest`` form.",
  "properties": {
    "attestation": {
      "anyOf": [
        {
          "$ref": "#/$defs/MinerProbeAttestationV2"
        },
        {
          "type": "null"
        }
      ]
    },
    "edge_instance": {
      "pattern": "^[A-Za-z0-9._-]{1,128}$",
      "title": "Edge Instance",
      "type": "string"
    },
    "endpoint_id": {
      "maxLength": 320,
      "minLength": 3,
      "title": "Endpoint Id",
      "type": "string"
    },
    "evidence_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Digest Sha256",
      "type": "string"
    },
    "expected_body_length": {
      "maximum": 16777216,
      "minimum": 0,
      "title": "Expected Body Length",
      "type": "integer"
    },
    "expected_body_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Body Sha256",
      "type": "string"
    },
    "expected_header_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Header Sha256",
      "type": "string"
    },
    "expected_status": {
      "maximum": 599,
      "minimum": 100,
      "title": "Expected Status",
      "type": "integer"
    },
    "generation": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "observed_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "title": "Observed At",
      "type": "string"
    },
    "observed_body_length": {
      "anyOf": [
        {
          "maximum": 16777216,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Body Length"
    },
    "observed_body_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Body Sha256"
    },
    "observed_header_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Header Sha256"
    },
    "observed_status": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Status"
    },
    "receipt_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Receipt Digest",
      "type": "string"
    },
    "release_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Release Digest",
      "type": "string"
    },
    "request_method": {
      "enum": [
        "GET",
        "HEAD"
      ],
      "title": "Request Method",
      "type": "string"
    },
    "request_path": {
      "maxLength": 1024,
      "pattern": "^/(?:[\\x21\\x22\\x24-\\x2e\\x30-\\x3e\\x40-\\x7e][\\x21\\x22\\x24-\\x3e\\x40-\\x7e]*)?$",
      "title": "Request Path",
      "type": "string"
    },
    "route_label": {
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "title": "Route Label",
      "type": "string"
    },
    "schema": {
      "const": "miss.computer/misscomputer-subnet/static-edge-evidence",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "site_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Site Digest",
      "type": "string"
    },
    "stage": {
      "enum": [
        "admission_crawl",
        "ordinary_traffic"
      ],
      "title": "Stage",
      "type": "string"
    },
    "ticket_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Ticket Digest",
      "type": "string"
    },
    "upstream_marker": {
      "title": "Upstream Marker",
      "type": "boolean"
    },
    "verdict": {
      "enum": [
        "content_fault",
        "pass",
        "path_fault"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "stage",
    "edge_instance",
    "route_label",
    "site_digest",
    "release_digest",
    "endpoint_id",
    "generation",
    "ticket_digest",
    "receipt_digest",
    "request_method",
    "request_path",
    "expected_status",
    "expected_header_sha256",
    "expected_body_length",
    "expected_body_sha256",
    "observed_status",
    "observed_header_sha256",
    "observed_body_length",
    "observed_body_sha256",
    "upstream_marker",
    "attestation",
    "observed_at",
    "verdict",
    "evidence_digest_sha256"
  ],
  "title": "StaticEdgeEvidence",
  "type": "object"
}
