{
  "additionalProperties": false,
  "description": "Validator-hotkey (sr25519) authorization for one targeted hidden probe.",
  "properties": {
    "endpoint_id": {
      "maxLength": 320,
      "minLength": 3,
      "title": "Endpoint Id",
      "type": "string"
    },
    "generation": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "issued_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Issued At",
      "type": "string"
    },
    "method": {
      "enum": [
        "GET",
        "HEAD"
      ],
      "title": "Method",
      "type": "string"
    },
    "nonce": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Nonce",
      "type": "string"
    },
    "path": {
      "maxLength": 1024,
      "pattern": "^/(?:[\\x21\\x22\\x24-\\x2e\\x30-\\x3e\\x40-\\x7e][\\x21\\x22\\x24-\\x3e\\x40-\\x7e]*)?$",
      "title": "Path",
      "type": "string"
    },
    "schema": {
      "const": "miss.computer/misscomputer-subnet/organic-probe-authorization",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "signature": {
      "pattern": "^[0-9a-f]{128}$",
      "title": "Signature",
      "type": "string"
    },
    "validator_hotkey": {
      "pattern": "^[A-Za-z0-9]{1,128}$",
      "title": "Validator Hotkey",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "validator_hotkey",
    "endpoint_id",
    "generation",
    "method",
    "path",
    "nonce",
    "issued_at",
    "signature"
  ],
  "title": "OrganicProbeAuthorization",
  "type": "object"
}
